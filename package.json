{
  "name": "water",
  "version": "1.0.0",
  "description": "Configurable physically-based ocean for PlayCanvas \u2014 cascaded FFT waves on WebGPU compute with a WebGL2 fallback",
  "type": "module",
  "exports": {
    ".": "./src/index.js",
    "./sky": "./src/sky/index.js",
    "./scripts": "./src/scripts/index.js"
  },
  "files": [
    "src",
    "dist-editor",
    "docs/playcanvas.md"
  ],
  "sideEffects": false,
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test tests/*.test.js",
    "build:editor": "node scripts/build-editor.js",
    "prepack": "npm run build:editor",
    "build:coast": "node scripts/build-coast.mjs",
    "deploy": "node scripts/deploy-pages.mjs"
  },
  "peerDependencies": {
    "playcanvas": "^2.22.0"
  },
  "devDependencies": {
    "playcanvas": "^2.22.0",
    "rollup": "^4.63.1",
    "vite": "^6.3.5"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/marklundin/water.git"
  },
  "homepage": "https://marklundin.github.io/water/"
}
